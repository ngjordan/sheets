# The app's branding, in one place.
#
# Edit these values, then:
#   packaging/apply-brand.sh     # regenerates the icons and stamps the packaging templates
#   cargo build --release        # the Rust side reads this file at compile time
#
# APP_ID is the installed identity: the macOS bundle id, the Linux desktop
# entry name, the hicolor icon names and the Windows product id. It is tied to
# the Developer ID signature, so change it only for a build you sign yourself.
APP_NAME="Sheets"
APP_SLUG="iridium-sheets"
APP_ID="ph.sheets"
APP_VENDOR="Iridium Technologies, Inc."
APP_HOMEPAGE="https://github.com/ngjordan/iridium-sheets"
APP_ICON_SVG="assets/app-icon/iridium-sheets.svg"
